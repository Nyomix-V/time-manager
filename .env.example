# Copy to .env and fill in.  NEVER commit the real .env (it is in .gitignore).

# --- Database (MySQL) ---
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=timemanager
MYSQL_USER=timemanager
MYSQL_PASSWORD=devpassword

# --- Backend ---
DB_SYNC=true                              # dev: TypeORM creates tables from entities; set false in prod
JWT_SECRET=change_me_to_a_long_random_string

# --- Microsoft SSO (Azure AD app registration) ---
MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_TENANT_ID=common

# --- Mobile build ---
# localhost works on the emulator and on a USB phone after: adb reverse tcp:8080 tcp:8080
# Phone on the same Wi-Fi instead: http://<PC IP>:8080/api
PUBLIC_API_URL=http://localhost:8080/api
