# Copier en .env pour le développement (npx expo start).
# Adresse de l'API vue depuis le téléphone :
#  - émulateur ou téléphone branché en USB : http://localhost:8080/api, après « adb reverse tcp:8080 tcp:8080 »
#  - téléphone réel sur le même Wi-Fi : http://<IP de votre PC>:8080/api
EXPO_PUBLIC_API_URL=http://localhost:8080/api

# 1 = mode démo : faux comptes et fausses données, aucun appel au backend.
EXPO_PUBLIC_MOCK=0
